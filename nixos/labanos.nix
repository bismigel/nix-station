# labanos - NixOS system configuration.
#
# Void Linux was replaced with a declarative NixOS install: full-disk
# encryption (LUKS2) + btrfs (zstd, subvolumes) + LVM swap for hibernation.
# The home configuration is the same merged `station.home` module used by the
# standalone home-manager hosts (wired up in modules/nixos-configurations.nix).

{ config, pkgs, lib, ... }:
{
  imports = [ ./disko-labanos.nix ];

  # ---- Hardware ----
  hardware.cpu.amd.updateMicrocode = true;
  # AMD RDNA3 (Radeon 780M) needs the amdgpu firmware from linux-firmware;
  # without it the GPU fails to init and sway runs on software rendering.
  hardware.enableRedistributableFirmware = true;
  hardware.graphics.enable = true;

  # Firmware updates (fwupd/`fwupdmgr`, LVFS). The service pulls in udisks2
  # and polkit, and exposes devices to the system DBus.
  services.fwupd.enable = true;

  # ---- Boot: UEFI + systemd-boot + LUKS2 ----
  boot = {
    loader = {
      systemd-boot.enable = true;
      efi.canTouchEfiVariables = true;
    };
    initrd.systemd.enable = true;
    # `device` is generated by disko from the LUKS partition; only add the
    # TRIM/discard flag here.
    initrd.luks.devices."cryptroot".allowDiscards = true;
    # `snd_hda_intel.power_save=0` keeps the ALC295 codec from autosuspending a
    # second after playback stops; see the audio section below.
    kernelParams = [
      "quiet"
      "snd_hda_intel.power_save=0"
    ];
  };

  # ---- Networking (WiFi-only, managed by NetworkManager) ----
  networking = {
    hostName = "labanos";
    networkmanager.enable = true;
  };

  # WiFi PSK is never committed to git and never enters the Nix store. The
  # declarative profile leaves the secret agent-owned (psk-flags=1) and
  # nm-file-secret-agent (nixpkgs' `ensureProfiles.secrets`) hands NetworkManager
  # the contents of a root-only file at activation time.
  #
  # Because the previous version read the key at *build* time via
  # `builtins.getEnv "POTATO_CORNER_PSK"`, any rebuild without that variable
  # exported wrote `psk=` empty, so NetworkManager asked a secret agent for it,
  # found none ("no secrets: No agents were available") and autoconnect failed
  # on every boot until the key was typed in again.
  #
  # One-time setup (file survives rebuilds, /etc is not tmpfs):
  #   sudo install -d -m 0700 /etc/nixos-secrets
  #   sudo sh -c 'umask 077; bw get password "Potato Corner WiFi" --raw \
  #     > /etc/nixos-secrets/potato-corner.psk'
  networking.networkmanager.ensureProfiles = {
    profiles."Potato Corner" = {
      connection = {
        id = "Potato Corner";
        type = "wifi";
        autoconnect = true;
      };
      wifi = {
        mode = "infrastructure";
        ssid = "Potato Corner";
      };
      wifi-security = {
        auth-alg = "open";
        key-mgmt = "wpa-psk";
        # 1 = agent-owned: never persisted in the connection profile.
        psk-flags = "1";
      };
      ipv4.method = "auto";
      ipv6.method = "auto";
    };
    secrets.entries = [
      {
        matchId = "Potato Corner";
        matchType = "802-11-wireless";
        matchSetting = "802-11-wireless-security";
        key = "psk";
        file = "/etc/nixos-secrets/potato-corner.psk";
      }
    ];
  };

  # ---- Bluetooth (WiFi/BT combo card) ----
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
  };
  # Tray applet (blueman-applet) + manager (blueman-manager, bound to
  # $mod+Shift+b in files/sway/config).
  services.blueman.enable = true;

  # ---- Audio: Framework Laptop 16 (ALC295 + the two speaker amps) ----
  # Baseline on this machine: `snd_hda_intel.power_save=1` (set to 0 in
  # boot.kernelParams above), so the codec autosuspends a second after audio
  # stops and the first ~200 ms of the next stream gets clipped, plus an audible
  # pop. PipeWire suspends the node on idle as well. Both are off now: the cost
  # is roughly half a watt, the gain is gapless playback and no pops.
  # PipeWire only gets realtime scheduling through rtkit; without it the audio
  # thread competes with the compositor and dropouts show up as crackle.
  security.rtkit.enable = true;
  services.pipewire = {
    # alsa.support32Bit/pulse are already on by default here; keep the graph at
    # the codec's native 48 kHz but let 44.1 kHz material run natively instead of
    # through the resampler. 1024 frames (~21 ms) is the sweet spot for this
    # codec - lower quanta are what make AMD HDA crackle under load - and the
    # 256 floor stops applications from asking for more than it can deliver.
    extraConfig.pipewire."10-framework16-clock" = {
      "context.properties" = {
        "default.clock.rate" = 48000;
        "default.clock.allowed-rates" = [
          44100
          48000
        ];
        "default.clock.quantum" = 1024;
        "default.clock.min-quantum" = 256;
        "default.clock.max-quantum" = 4096;
        # Music is the common case here and resampling 44.1k content is cheap on
        # this CPU; drop to 4 (PipeWire's default) if it ever shows up in top.
        "resample.quality" = 10;
      };
    };
    # Upstream default is `api.alsa.headroom = 0`, which leaves the ALSA ring
    # buffer with no slack - the usual cause of intermittent crackle - and
    # `session.suspend-timeout-seconds = 1`, which re-introduces the codec
    # suspend above at the PipeWire level.
    wireplumber.extraConfig."50-framework16-speakers" = {
      "monitor.alsa.rules" = [
        {
          matches = [ { "node.name" = "~alsa_output.*"; } ];
          actions.update-props = {
            "api.alsa.headroom" = 512;
            "node.pause-on-idle" = false;
            "session.suspend-timeout-seconds" = 0;
          };
        }
      ];
    };
  };

  # ---- Brave: debloat via managed policies ----
  # Brave reads system-wide policy from /etc/brave/policies/managed. Everything
  # listed here gets removed from the UI and locked off (the toggles grey out),
  # which is the point of a debloat list - keep it short and deliberate.
  # Cost: Brave then reports itself as "managed by your organization".
  environment.etc."brave/policies/managed/debloat.json".text = builtins.toJSON {
    BraveRewardsDisabled = true; # Rewards, Brave Ads, NTP sponsored images
    BraveWalletDisabled = true; # built-in crypto wallet
    BraveVPNDisabled = true; # VPN upsell
    BraveNewsDisabled = true; # Brave News feed
    BraveTalkDisabled = true; # Brave Talk upsell
    BraveAIChatEnabled = false; # Leo AI assistant (sends page text to Brave)
    TorDisabled = true; # private window with Tor
    BraveWebDiscoveryEnabled = false; # opt-in search index telemetry
    BraveStatsPingEnabled = false; # daily P3A/stats ping
    BraveP3AEnabled = false;
    MetricsReportingEnabled = false; # Chromium UMA
    UrlKeyedAnonymizedDataCollectionEnabled = false;
  };

  # ---- Secrets service (org.freedesktop.secrets) ----
  # ProtonVPN's GTK app probes the keyring backend before it even shows a
  # window; with no Secret Service on the session bus it dies with
  #   keyring.errors.InitError / DBusErrorResponse(NameHasNoOwner)
  #   "Could not activate remote peer 'org.freedesktop.secrets': unit failed"
  # `gnome-keyring` being a *home* package only puts the daemon binary in the
  # user profile - the D-Bus activation file ships in the package's share/ and
  # home-manager does not expose share/dbus-1/services. Enabling the system
  # module installs it into /run/current-system/sw/share/dbus-1/services (which
  # is on XDG_DATA_DIRS) so the session bus can activate it on demand.
  services.gnome.gnome-keyring.enable = true;
  # That module only adds pam_gnome_keyring to the "login" service, but ly has
  # its own stack (security.pam.services.ly, useDefaultRules = false), so the
  # keyring was never unlocked and ProtonVPN asked to create/unlock one on every
  # launch. Mirror the rules into ly's stack, ordered right after its `login`
  # (pam_unix) rule so `use_authtok` sees the password typed at the prompt.
  # Both rules are `optional`, so they can never block a login.
  security.pam.services.ly.rules = {
    auth.gnome_keyring = {
      order = config.security.pam.services.ly.rules.auth.login.order + 10;
      control = "optional";
      modulePath = "${pkgs.gnome-keyring}/lib/security/pam_gnome_keyring.so";
      settings.use_authtok = true;
    };
    password.gnome_keyring = {
      order = config.security.pam.services.ly.rules.password.login.order + 10;
      control = "optional";
      modulePath = "${pkgs.gnome-keyring}/lib/security/pam_gnome_keyring.so";
      settings.use_authtok = true;
    };
    session.gnome_keyring = {
      order = config.security.pam.services.ly.rules.session.login.order + 10;
      control = "optional";
      modulePath = "${pkgs.gnome-keyring}/lib/security/pam_gnome_keyring.so";
      settings.auto_start = true;
    };
  };

  # ---- Locale / time ----
  time.timeZone = "America/Toronto";
  i18n.defaultLocale = "en_US.UTF-8";

  # ---- Nix ----
  nixpkgs.config.allowUnfree = true;
  nix = {
    settings.experimental-features = [ "nix-command" "flakes" ];
    gc = {
      automatic = true;
      dates = "weekly";
      options = "--delete-older-than 14d";
    };
  };

  # ---- User ----
  users.users.labanos = {
    isNormalUser = true;
    description = "labanos";
    extraGroups = [
      "wheel"
      "networkmanager"
      "video"
      "audio"
      "input"
      "kvm"
      "storage"
      "lp"
      "dialout"
    ];
    # Password hash is not stored in git. It is provisioned at install time
    # from Bitwarden Secrets Manager to this path (see nixos/README).
    hashedPasswordFile = "/etc/nixos-secrets/labanos.hash";
  };

  # ---- Sway session + login manager ----
  programs.sway.enable = true;
  services.displayManager = {
    ly.enable = true;
    defaultSession = "sway";
  };

  # ---- Gaming (Steam) ----
  # The module brings its own 32-bit graphics support
  # (hardware.graphics.enable32Bit), controller udev rules and Steam runtime;
  # `nixpkgs.config.allowUnfree` below covers the package itself.
  # gamescope is installed separately in modules/home/packages.nix.
  programs.steam = {
    enable = true;
    # In-home streaming / Remote Play uses UDP 27031-27036 and TCP 27036-27037.
    remotePlay.openFirewall = true;
    localNetworkGameTransfers.openFirewall = true;
  };

  # ---- Remote access ----
  services.openssh.enable = true;

  # ---- Power: full performance on AC, maximum savings on battery ----
  powerManagement.enable = true;
  services.tlp = {
    enable = true;
    settings = {
      # AC: full performance
      CPU_SCALING_GOVERNOR_ON_AC = "performance";
      CPU_ENERGY_PERF_POLICY_ON_AC = "performance";
      CPU_BOOST_ON_AC = 1;
      PLATFORM_PROFILE_ON_AC = "performance";
      RADEON_DPM_STATE_ON_AC = "performance";
      WIFI_PWR_ON_AC = "off";
      PCIE_ASPM_ON_AC = "default";
      # Battery: maximum savings
      CPU_SCALING_GOVERNOR_ON_BAT = "powersave";
      CPU_ENERGY_PERF_POLICY_ON_BAT = "power";
      CPU_BOOST_ON_BAT = 0;
      PLATFORM_PROFILE_ON_BAT = "low-power";
      RADEON_DPM_STATE_ON_BAT = "battery";
      WIFI_PWR_ON_BAT = "on";
      PCIE_ASPM_ON_BAT = "powersupersave";
      USB_AUTOSUSPEND = 1;
    };
  };
  services.logind.settings = {
    Login = {
      HandleLidSwitch = "suspend";
      HandleLidSwitchExternalPower = "suspend";
    };
  };

  # ---- Minimal system packages ----
  environment.systemPackages = with pkgs; [ git ];

  system.stateVersion = "25.05";
}
