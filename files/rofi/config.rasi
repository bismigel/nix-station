/* Dark theme (installed next to this file from the rofi package). */
@theme "Arc-Dark.rasi"

configuration {
    font: "Lekton Nerd Font Bold 16";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "ghostty";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
}

