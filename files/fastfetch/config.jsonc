{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Keep the output compact: no blank module rows, one line each, and a
  // neutral key colour that matches the black waybar theme.
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "yellow"
    }
  },
  "modules": [
    "title",
    "separator",

    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },

    "break",
    { "type": "wm", "key": "WM" },
    { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },

    "break",
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk", "folders": "/" },

    "break",
    { "type": "localip", "key": "Local IP" },
    { "type": "battery", "key": "Battery" },

    "break",
    "colors"
  ]
}
